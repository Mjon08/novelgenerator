ANTHROPIC_API_KEY=your-api-key-here
PORT=3000

# Supabase — Project Settings > API & Database di dashboard Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service Role Key (BUKAN anon key) — server ini backend tepercaya, bypass RLS.
# JANGAN pernah kirim key ini ke browser/frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Password gerbang login situs (satu password untuk seluruh app — bukan
# multi-akun). WAJIB diisi, pilih sendiri password yang kuat.
APP_LOGIN_PASSWORD=ganti-dengan-password-anda-sendiri
